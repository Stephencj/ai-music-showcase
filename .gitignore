ios/**/DerivedData/
ios/build/

# macOS resource forks
._.DS_Store
# block waveform-peak sidecars (generated)
data/blocks/*.peaks.json
# block score-export bundles (generated: full_score.pdf + parts)
data/blocks/*.zip
# saved vocal takes (generated audio/scores per block)
data/blocks/*.vocals/
# AI request queue (answered by a Claude Code watch-loop)
data/ai_requests/

# Generated Xcode project — regenerate with: cd ios && xcodegen
ios/AiMusic.xcodeproj/
