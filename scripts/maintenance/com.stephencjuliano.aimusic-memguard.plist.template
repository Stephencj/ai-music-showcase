<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the AI Music Studio memory watchdog.

  @PROJECT_ROOT@ and @CAP_MB@ are substituted by install_mem_guardrail.sh.

  This agent runs mem_guardrail.sh in a permanent loop (KeepAlive) and
  kills the aimusic server if its resident memory crosses the cap, so a
  runaway render can't exhaust RAM/swap and hang the whole Mac.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stephencjuliano.aimusic-memguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@RUNTIME_SCRIPT@</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AI_MUSIC_PROJECT_ROOT</key>
        <string>@PROJECT_ROOT@</string>
        <key>AI_MUSIC_MEM_CAP_MB</key>
        <string>@CAP_MB@</string>
        <key>AI_MUSIC_MEM_INTERVAL</key>
        <string>20</string>
        <key>AI_MUSIC_MEM_GRACE</key>
        <string>10</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@PROJECT_ROOT@/logs/memguard.out</string>

    <key>StandardErrorPath</key>
    <string>@PROJECT_ROOT@/logs/memguard.err</string>
</dict>
</plist>
